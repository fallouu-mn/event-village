# ============================================================================
# EVENT VILLAGE — ENVIRONNEMENT DE TEST (copier vers .env.test, ignoré par git)
# ============================================================================
# Les tests refusent de démarrer si NEXT_PUBLIC_SUPABASE_URL n'est pas locale.
# Instance locale : `npx supabase start` puis `npx supabase status` pour les clés.
# Les clés ci-dessous sont les clés de démonstration PUBLIQUES de Supabase local ;
# elles n'ouvrent aucun accès à un projet hébergé.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Connexion Postgres directe de l'instance LOCALE (tests de catalogue tests/schema uniquement)
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Intégrations externes : toujours les faux adaptateurs en test
EV_INTEGRATIONS=fake

# SamirPay — valeurs factices ; les URLs pointent sur un port local fermé (port 9 = discard)
SAMIRPAY_API_URL=http://127.0.0.1:9/samirpay-fake
SAMIRPAY_API_KEY=samirpay-test-api-key
SAMIRPAY_SECRET_KEY=samirpay-test-secret-key
# Lot 9 bis (H3) : SAMIRPAY_WEBHOOK_SECRET reste ABSENTE ici (comportement sans signature) ; les suites de la
# signature fabriquent un secret de test et le posent par withEnv dans leur processus.

# MTarget SMS — valeurs factices
MTARGET_API_URL=http://127.0.0.1:9/mtarget-fake
MTARGET_USERNAME=mtarget-test
MTARGET_PASSWORD=mtarget-test
MTARGET_SENDER=EVTEST

# Email — aucune clé réelle (le faux adaptateur enregistre les envois)
RESEND_API_KEY=re_test_fake
NOTIFICATION_FROM_EMAIL=notifications@test.eventvillage.local
SUPPORT_EMAIL=support@test.eventvillage.local

# Push web (lot 6) — AUCUNE clé VAPID ici : les tests génèrent leur paire (withVapid,
# tests/parcours/notif-helpers.ts) ; tests/helpers/env.ts refuse de démarrer si VAPID_PRIVATE_KEY est
# renseignée dans ce fichier ou dans le shell. Quotas : valeurs du contrat (défauts de lib/env.ts).
PUSH_SUBSCRIBE_PER_USER_HOUR=20
PUSH_TEST_PER_USER_HOUR=5

# Divers (valeurs factices)
SUPERADMIN_PHONE=700000007
SUPABASE_AUTH_HOOK_SECRET=whsec_test_only_not_a_real_secret
CRON_SECRET=cron-test-secret

# Codes OTP — secret HMAC factice dédié aux tests (lot 1C.4 ; 32 caractères au moins)
OTP_HASH_SECRET=otp-hash-secret-de-test-local-non-secret-0001

# Lot 4 — clés dédiées factices, générées pour les tests (32 caractères au moins, distinctes entre
# elles et des autres secrets) : code dynamique des billets et PIN régisseur
TICKET_TOTP_MASTER_KEY=test-local-ticket-totp-09c0197011a139ad0f2f17b97c7a98d432f82196
REGISSEUR_PIN_KEY=test-local-regisseur-pin-b7244ea8ad9cb7b0a4524ea052711b37b4d24e53

# Anti-abus SMS (lot 1C.9) — limites larges pour les suites ordinaires ;
# tests/parcours/sms-anti-abus.test.ts règle ses propres petites limites dans son processus.
SMS_OTP_PER_PHONE_15MIN=1000
SMS_OTP_PER_PHONE_DAY=1000
SMS_OTP_PER_IP_HOUR=1000
SMS_OTP_PER_IP_DAY=1000
SMS_PER_PHONE_DAY=1000
SMS_GLOBAL_DAILY_CAP=100000
# Lot 9 quater (A8) : part propre des codes vers un numéro sans compte (inscriptions), large pour les suites ordinaires
SMS_OTP_NEW_NUMBER_DAILY_CAP=100000
CLIENT_IP_SOURCE=x-forwarded-for
DOCUMENT_UPLOADS_PER_IP_HOUR=1000

# Lot 2 — chaîne paiement → billet : limites larges pour les suites ordinaires ;
# tests/parcours/paiement-controles.test.ts règle sa propre petite limite dans son processus.
CHECKOUT_PER_USER_15MIN=1000
CHECKOUT_PER_USER_DAY=10000
CLAIM_FREE_PER_USER_HOUR=1000

# Lot 4 — quotas du contrôle d'accès et anti-abus SMS : valeurs du contrat (défauts de lib/env.ts) ;
# tests/parcours/acces-limiteurs.test.ts règle ses propres petites limites dans son processus.
SCAN_PER_SCANNER_10S=30
LIVE_CODE_PER_USER_MIN=60
RESOLVE_PHONE_PER_IP_HOUR=30
VERIFY_OTP_PER_PHONE_15MIN=10
CONTROLLER_SETUP_PER_PHONE_HOUR=10
PARTNER_REGISTER_PER_IP_HOUR=10
INVITE_PER_PARTNER_HOUR=20
INVITE_PER_PHONE_DAY=3
REGISSEUR_PIN_PER_SHIFT_15MIN=5
WITHDRAWAL_REQUEST_PER_USER_HOUR=10
COUNTER_RECEIPT_PER_SHIFT_DAY=500
SCAN_INCIDENT_REPORT_PER_SCANNER_MIN=10
SCAN_INCIDENT_LOG_PER_SCANNER_MIN=60
# Lot 7 : codes hors ligne (par billet et par compte, par heure) ; saisie manuelle au scanner (par minute)
OFFLINE_CODES_PER_TICKET_HOUR=12
OFFLINE_CODES_PER_USER_HOUR=60
SCAN_LOOKUP_PER_SCANNER_MIN=20
SMS_PER_ACCOUNT_DAY=30
SMS_GLOBAL_OTP_RESERVED_PERCENT=30
# Lot 9 : invitations (par événement et par heure, par numéro et par jour), changement de numéro (par compte
# et par jour), photo (par compte et par heure) ; valeurs du contrat, les suites de quota règlent les leurs par withEnv
INVITATION_PER_EVENT_HOUR=50
INVITATION_PER_PHONE_DAY=3
PHONE_CHANGE_PER_ACCOUNT_DAY=5
AVATAR_UPLOADS_PER_ACCOUNT_HOUR=20
# Lot 9 bis : mot de passe (confirmations et changements par compte et par 15 minutes ; connexions par IP et par
# heure), liens de vérification d'email (par compte et par heure, par adresse et par jour) ; valeurs du contrat
# (défauts de lib/env.ts), les suites de quota règlent les leurs par withEnv
PASSWORD_CONFIRM_PER_ACCOUNT_15MIN=5
PASSWORD_LOGIN_PER_IP_HOUR=30
EMAIL_VERIFY_PER_ACCOUNT_HOUR=3
EMAIL_VERIFY_PER_ADDRESS_DAY=5
# Lot 9 ter : recherches dans la liste des invités par contrôleur et par heure ; valeur du contrat (défaut de
# lib/env.ts), invites-recherche en consomme 30 puis attend le refus de la 31e
GUEST_LIST_SEARCH_PER_SCANNER_HOUR=30
