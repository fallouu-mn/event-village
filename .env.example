# ============================================================================
# EVENT VILLAGE — EXEMPLE DE VARIABLES D'ENVIRONNEMENT
# ============================================================================
# Ne jamais inscrire de clés de production réelles dans ce fichier.
# ============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SamirPay API
# Développement / Sandbox : https://sandbox.samirpay.com/samirpays
# Production : https://app.samirpay.com/samirpays
PAYMENT_PROVIDER_NAME=samirpay
SAMIRPAY_API_URL=https://sandbox.samirpay.com/samirpays
SAMIRPAY_API_KEY=your_samirpay_api_key
SAMIRPAY_SECRET_KEY=your_samirpay_secret_key
# Webhook : aucune signature dans le contrat SamirPay (jeton aléatoire par paiement dans le callBackUrl).
# Les anciennes variables SAMIRPAY_CASHIN_URL, _CASHOUT_URL, _SOLDE_URL, _STATUS_URL et
# SAMIRPAY_WEBHOOK_SECRET ne sont plus lues : chemins fixés par le contrat sous SAMIRPAY_API_URL.
# SAMIRPAY_TIMEOUT_MS=15000

# Administration
SUPERADMIN_PHONE=773780756

# MTarget SMS Gateway — OBLIGATOIRE (le SMS est le canal essentiel ; le serveur refuse de démarrer sans)
MTARGET_USERNAME=your_mtarget_username
MTARGET_PASSWORD=your_mtarget_password
MTARGET_SENDER=EventVillage

# Supabase Auth SMS Hook (secret Standard Webhooks « v1,whsec_… ») — OBLIGATOIRE si le hook est activé :
# sans lui, /api/auth/sms-hook refuse tout appel (lot 1C.9)
SUPABASE_AUTH_HOOK_SECRET=whsec_your_svix_secret_here

# Notifications Email & Support
SUPPORT_EMAIL=support@eventvillage.sn
NOTIFICATION_FROM_EMAIL=notifications@eventvillage.sn

# Resend — Service d'envoi d'emails transactionnels (https://resend.com)
# Obtenir une clé gratuite sur : https://resend.com/signup (3 000 emails/mois offerts)
# OPTIONNEL : sans cette clé, le canal email est désactivé (un avertissement au démarrage) ;
# SMS et notifications in-app partent normalement.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Codes OTP — OBLIGATOIRE : secret HMAC dédié (openssl rand -hex 32), jamais réutilisé ailleurs
OTP_HASH_SECRET=

# Code dynamique des billets (QR) et PIN régisseur — OBLIGATOIRES : deux secrets dédiés
# (openssl rand -hex 32 chacun), différents entre eux et de toute autre clé. Changer
# TICKET_TOTP_MASTER_KEY invalide les QR affichés (rafraîchis en 20 s) ; changer REGISSEUR_PIN_KEY
# oblige les organisateurs à régénérer leurs PIN.
TICKET_TOTP_MASTER_KEY=
REGISSEUR_PIN_KEY=

# Anti-abus SMS (chaque SMS est facturé) — valeurs par défaut prudentes si absentes
# SMS_OTP_PER_PHONE_15MIN=3
# SMS_OTP_PER_PHONE_DAY=10
# SMS_OTP_PER_IP_HOUR=10
# SMS_OTP_PER_IP_DAY=30
# Notifications (hors OTP) par destinataire et par jour
# SMS_PER_PHONE_DAY=30
# SMS_GLOBAL_DAILY_CAP=1000
# SMS non OTP déclenchés par un même compte connecté, par jour
# SMS_PER_ACCOUNT_DAY=30
# Part du plafond global réservée à l'OTP (les autres SMS s'arrêtent à 100 − part %)
# SMS_GLOBAL_OTP_RESERVED_PERCENT=30
# Quotas du contrôle d'accès et des routes publiques (lot 4)
# SCAN_PER_SCANNER_10S=30
# CASH_COLLECT_PER_SCANNER_MIN=20
# LIVE_CODE_PER_USER_MIN=60
# RESOLVE_PHONE_PER_IP_HOUR=30
# VERIFY_OTP_PER_PHONE_15MIN=10
# CONTROLLER_SETUP_PER_PHONE_HOUR=10
# PARTNER_REGISTER_PER_IP_HOUR=10
# INVITE_PER_PARTNER_HOUR=20
# INVITE_PER_PHONE_DAY=3
# REGISSEUR_PIN_PER_SHIFT_15MIN=5
# Source de l'IP cliente : x-forwarded-for (hébergeur qui réécrit l'en-tête, ex. Vercel), x-real-ip, none
# CLIENT_IP_SOURCE=x-forwarded-for
# Dépôts publics de pièces d'inscription partenaire, par IP et par heure
# DOCUMENT_UPLOADS_PER_IP_HOUR=20

# URL publique de l'application (utilisée dans les liens des emails)
NEXT_PUBLIC_APP_URL=https://eventvillage.sn

# Tâches planifiées (réconciliation des paiements, purge des réservations) — OBLIGATOIRE :
# les routes /api/cron refusent tout appel sans « Authorization: Bearer <CRON_SECRET> »
CRON_SECRET=

# Chaîne paiement → billet (lot 2) — valeurs par défaut si absentes
# PAYMENT_HOLD_MINUTES=15
# CHECKOUT_PER_USER_15MIN=10
# CHECKOUT_PER_USER_DAY=50
# CLAIM_FREE_PER_USER_HOUR=20
# PAYMENT_RECONCILE_MIN_AGE_MINUTES=2
# PAYMENT_PENDING_MAX_AGE_MINUTES=60
# PAYMENT_LATE_SUCCESS_WINDOW_HOURS=48
