# ============================================================================
# EVENT VILLAGE — EXEMPLE DE VARIABLES D'ENVIRONNEMENT
# ============================================================================
# Ne jamais inscrire de clés de production réelles dans ce fichier.
# ============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SamirPay API
# Développement / Sandbox : https://sandbox.samirpay.com/samirpays
# Production : https://app.samirpay.com/samirpays
PAYMENT_PROVIDER_NAME=samirpay
SAMIRPAY_API_URL=https://sandbox.samirpay.com/samirpays
SAMIRPAY_API_KEY=your_samirpay_api_key
SAMIRPAY_SECRET_KEY=your_samirpay_secret_key
SAMIRPAY_WEBHOOK_SECRET=your_samirpay_webhook_secret

# Administration
SUPERADMIN_PHONE=773780756

# MTarget SMS Gateway — OBLIGATOIRE (le SMS est le canal essentiel ; le serveur refuse de démarrer sans)
MTARGET_USERNAME=your_mtarget_username
MTARGET_PASSWORD=your_mtarget_password
MTARGET_SENDER=EventVillage

# Supabase Auth SMS Hook (secret Standard Webhooks « v1,whsec_… ») — OBLIGATOIRE si le hook est activé :
# sans lui, /api/auth/sms-hook refuse tout appel (lot 1C.9)
SUPABASE_AUTH_HOOK_SECRET=whsec_your_svix_secret_here

# Notifications Email & Support
SUPPORT_EMAIL=support@eventvillage.sn
NOTIFICATION_FROM_EMAIL=notifications@eventvillage.sn

# Resend — Service d'envoi d'emails transactionnels (https://resend.com)
# Obtenir une clé gratuite sur : https://resend.com/signup (3 000 emails/mois offerts)
# OPTIONNEL : sans cette clé, le canal email est désactivé (un avertissement au démarrage) ;
# SMS et notifications in-app partent normalement.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Codes OTP — OBLIGATOIRE : secret HMAC dédié (openssl rand -hex 32), jamais réutilisé ailleurs
OTP_HASH_SECRET=

# Anti-abus SMS (chaque SMS est facturé) — valeurs par défaut prudentes si absentes
# SMS_OTP_PER_PHONE_15MIN=3
# SMS_OTP_PER_PHONE_DAY=10
# SMS_OTP_PER_IP_HOUR=10
# SMS_OTP_PER_IP_DAY=30
# SMS_PER_PHONE_DAY=30
# SMS_GLOBAL_DAILY_CAP=1000
# Source de l'IP cliente : x-forwarded-for (hébergeur qui réécrit l'en-tête, ex. Vercel), x-real-ip, none
# CLIENT_IP_SOURCE=x-forwarded-for

# URL publique de l'application (utilisée dans les liens des emails)
NEXT_PUBLIC_APP_URL=https://eventvillage.sn