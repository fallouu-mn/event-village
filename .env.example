# ============================================================================
# EVENT VILLAGE — EXEMPLE DE VARIABLES D'ENVIRONNEMENT
# ============================================================================
# Ne jamais inscrire de clés de production réelles dans ce fichier.
# ============================================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# SamirPay API
# Développement / Sandbox : https://sandbox.samirpay.com/samirpays
# Production : https://app.samirpay.com/samirpays
PAYMENT_PROVIDER_NAME=samirpay
SAMIRPAY_API_URL=https://sandbox.samirpay.com/samirpays
SAMIRPAY_API_KEY=your_samirpay_api_key
SAMIRPAY_SECRET_KEY=your_samirpay_secret_key
# Webhook : jeton aléatoire par paiement dans le callBackUrl, plus la signature facultative de la v1.2
# (SAMIRPAY_WEBHOOK_SECRET, bloc « Lot 9 bis » plus bas). Les anciennes variables SAMIRPAY_CASHIN_URL,
# _CASHOUT_URL, _SOLDE_URL et _STATUS_URL ne sont plus lues : chemins fixés sous SAMIRPAY_API_URL.
# SAMIRPAY_TIMEOUT_MS=15000

# Administration
SUPERADMIN_PHONE=773780756

# MTarget SMS Gateway — OBLIGATOIRE (le SMS est le canal essentiel ; le serveur refuse de démarrer sans)
MTARGET_USERNAME=your_mtarget_username
MTARGET_PASSWORD=your_mtarget_password
MTARGET_SENDER=EventVillage

# Supabase Auth SMS Hook (secret Standard Webhooks « v1,whsec_… ») — OBLIGATOIRE si le hook est activé :
# sans lui, /api/auth/sms-hook refuse tout appel (lot 1C.9)
SUPABASE_AUTH_HOOK_SECRET=whsec_your_svix_secret_here

# Notifications Email & Support
# SUPPORT_EMAIL : adresse de support montrée aux utilisateurs, lue côté serveur seulement (défaut si absente :
# support@eventvillage.sn)
SUPPORT_EMAIL=support@eventvillage.sn
NOTIFICATION_FROM_EMAIL=notifications@eventvillage.sn

# Resend — Service d'envoi d'emails transactionnels (https://resend.com)
# Obtenir une clé gratuite sur : https://resend.com/signup (3 000 emails/mois offerts)
# OPTIONNEL : sans cette clé, le canal email est désactivé (un avertissement au démarrage) ;
# SMS et notifications in-app partent normalement.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notifications push web (PWA, lot 6) — FACULTATIF : les trois variables ensemble, ou aucune.
# Sans elles, le canal push est désactivé (un avertissement au démarrage du premier envoi) et tout le
# reste fonctionne (application, SMS, email). Générer une paire : npx web-push generate-vapid-keys
# VAPID_PRIVATE_KEY est un secret : jamais réutilisée comme autre clé, jamais exposée au navigateur
# (seule la clé publique est servie par GET /api/push/config). Changer la paire supprime les abonnements
# existants au premier envoi : chaque appareil se réabonne à sa prochaine ouverture.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:notifications@eventvillage.sn
# Délais et quotas (valeurs par défaut si absentes)
# PUSH_TIMEOUT_MS=10000
# PUSH_SUBSCRIBE_PER_USER_HOUR=20
# PUSH_TEST_PER_USER_HOUR=5
# Liste blanche des services push (anti-SSRF) : NE PAS renseigner en production (la liste par défaut
# couvre Chrome, Firefox, Safari et Edge) ; réservé aux tests de bout en bout (faux service local).
# PUSH_ENDPOINT_ALLOWED_ORIGINS=
# Délai maximal d'un appel MTarget (ms) : au-delà, le SMS est « incertain » et n'est jamais renvoyé
# MTARGET_TIMEOUT_MS=15000
# Service et adresse de l'API MTarget : à ne renseigner que sur instruction du fournisseur
# MTARGET_SERVICE_ID=
# MTARGET_API_URL=

# Codes OTP — OBLIGATOIRE : secret HMAC dédié (openssl rand -hex 32), jamais réutilisé ailleurs
OTP_HASH_SECRET=

# Code dynamique des billets (QR) et PIN régisseur — OBLIGATOIRES : deux secrets dédiés
# (openssl rand -hex 32 chacun), différents entre eux et de toute autre clé. Changer
# TICKET_TOTP_MASTER_KEY invalide les QR affichés (rafraîchis en 20 s) ; changer REGISSEUR_PIN_KEY
# oblige les organisateurs à régénérer leurs PIN.
TICKET_TOTP_MASTER_KEY=
REGISSEUR_PIN_KEY=

# Anti-abus SMS (chaque SMS est facturé) — valeurs par défaut prudentes si absentes
# SMS_OTP_PER_PHONE_15MIN=3
# SMS_OTP_PER_PHONE_DAY=10
# SMS_OTP_PER_IP_HOUR=10
# SMS_OTP_PER_IP_DAY=30
# Notifications (hors OTP) par destinataire et par jour
# SMS_PER_PHONE_DAY=30
# SMS_GLOBAL_DAILY_CAP=1000
# SMS non OTP déclenchés par un même compte connecté, par jour
# SMS_PER_ACCOUNT_DAY=30
# Part du plafond global réservée à l'OTP (les autres SMS s'arrêtent à 100 − part %)
# SMS_GLOBAL_OTP_RESERVED_PERCENT=30
# Lot 9 quater (A8) : codes vers un numéro SANS compte (inscription, connexion d'un numéro inconnu) par jour, compteur
# propre qui ne tire pas sur SMS_GLOBAL_DAILY_CAP (défaut 90 = 30 % de la part des codes)
# SMS_OTP_NEW_NUMBER_DAILY_CAP=90
# Lot 9 quater (D1, D2) : transferts offerts par billet et par compte, numéros invités par compte, par jour
# TRANSFER_PER_TICKET_DAY=3
# TRANSFER_PER_ACCOUNT_DAY=10
# INVITATION_PER_ACCOUNT_DAY=50
# Quotas du contrôle d'accès et des routes publiques (lot 4)
# SCAN_PER_SCANNER_10S=30
# LIVE_CODE_PER_USER_MIN=60
# RESOLVE_PHONE_PER_IP_HOUR=30
# VERIFY_OTP_PER_PHONE_15MIN=10
# CONTROLLER_SETUP_PER_PHONE_HOUR=10
# PARTNER_REGISTER_PER_IP_HOUR=10
# INVITE_PER_PARTNER_HOUR=20
# INVITE_PER_PHONE_DAY=3
# REGISSEUR_PIN_PER_SHIFT_15MIN=5
# Lot 5 : demandes de retrait par compte et par heure ; reçus SMS du guichet par caisse et par jour ;
# incidents de scan déclarés par l'appareil (appels par minute) et écrits par le serveur (lignes par minute)
# WITHDRAWAL_REQUEST_PER_USER_HOUR=10
# COUNTER_RECEIPT_PER_SHIFT_DAY=500
# SCAN_INCIDENT_REPORT_PER_SCANNER_MIN=10
# SCAN_INCIDENT_LOG_PER_SCANNER_MIN=60
# Lot 7 : codes hors ligne d'un billet (GET /api/tickets/[id]/offline-codes), par billet et par compte, par heure
# OFFLINE_CODES_PER_TICKET_HOUR=12
# OFFLINE_CODES_PER_USER_HOUR=60
# Lot 7 : vérifications de saisie manuelle au scanner, par contrôleur et par minute
# SCAN_LOOKUP_PER_SCANNER_MIN=20
# Source de l'IP cliente : x-forwarded-for (hébergeur qui réécrit l'en-tête, ex. Vercel), x-real-ip, none
# CLIENT_IP_SOURCE=x-forwarded-for
# Dépôts publics de pièces d'inscription partenaire, par IP et par heure
# DOCUMENT_UPLOADS_PER_IP_HOUR=20
# Lot 9 : invitations (lignes numéro) par événement et par heure, puis par numéro et par jour
# INVITATION_PER_EVENT_HOUR=50
# INVITATION_PER_PHONE_DAY=3
# Lot 9 ter : recherches dans la liste des invités par contrôleur et par heure
# GUEST_LIST_SEARCH_PER_SCANNER_HOUR=30
# Lot 9 : codes de changement de numéro par compte et par jour ; envois de photo par compte et par heure
# PHONE_CHANGE_PER_ACCOUNT_DAY=5
# AVATAR_UPLOADS_PER_ACCOUNT_HOUR=20

# URL publique de l'application (utilisée dans les liens des emails)
NEXT_PUBLIC_APP_URL=https://eventvillage.sn

# Tâches planifiées (réconciliation des paiements, purge des réservations) — OBLIGATOIRE :
# les routes /api/cron refusent tout appel sans « Authorization: Bearer <CRON_SECRET> »
CRON_SECRET=

# Chaîne paiement → billet (lot 2) — valeurs par défaut si absentes
# (PAYMENT_HOLD_MINUTES est retirée au lot 9 bis : voir le bloc « Lot 9 bis » ci-dessous)
# CHECKOUT_PER_USER_15MIN=10
# CHECKOUT_PER_USER_DAY=50
# CLAIM_FREE_PER_USER_HOUR=20
# PAYMENT_RECONCILE_MIN_AGE_MINUTES=2
# PAYMENT_PENDING_MAX_AGE_MINUTES=60
# PAYMENT_LATE_SUCCESS_WINDOW_HOURS=48
# PAYMENT_RECONCILE_BATCH=50
# STATUS_POLL_RECONCILE_SECONDS=5

# Lot 9 bis — variables nouvelles ou réactivées, toutes FACULTATIVES (valeurs par défaut si absentes)
# Signature des webhooks SamirPay v1.2 : secret « whsec_… » (16 caractères au moins) donné par SamirPay quand la
# signature est activée. Défini : toute notification sans signature valide est refusée (401). Absent : aucune
# vérification de signature (jeton de callback seul). Ordre : activer la signature chez SamirPay, copier le
# secret ici, redémarrer le serveur. Secret : jamais réutilisé ailleurs.
# SAMIRPAY_WEBHOOK_SECRET=
# Confirmations et changements de mot de passe par compte, par 15 minutes
# PASSWORD_CONFIRM_PER_ACCOUNT_15MIN=5
# Connexions par mot de passe, par IP et par heure
# PASSWORD_LOGIN_PER_IP_HOUR=30
# Liens de vérification d'email par compte et par heure, puis par adresse et par jour
# EMAIL_VERIFY_PER_ACCOUNT_HOUR=3
# EMAIL_VERIFY_PER_ADDRESS_DAY=5
# PAYMENT_HOLD_MINUTES est retirée : la durée de garde des places pendant un paiement est un réglage du
# SUPERADMIN (finance.payment_hold_minutes, 10 minutes par défaut, de 5 à 60, page des réglages financiers).

# Cartes : fournisseur de tuiles (OpenStreetMap par défaut)
# NEXT_PUBLIC_MAP_TILE_URL=
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=

# ============================================================================
# MODE D'ESSAI LOCAL (lot 8) : à recopier dans .env.local, jamais en production
# ============================================================================
# Guide : docs/essai-local.md. Aucune valeur réelle ici ; ni $ ni # dans les valeurs de .env.local.
# ATTENTION : sans EV_INTEGRATIONS=fake, npm run dev et npm run cron:local envoient de vrais SMS et
# appellent le vrai SamirPay. Cette valeur est refusée hors développement et test (défaut : real).
# EV_INTEGRATIONS=fake
# Faux SamirPay local (npm run fake:samirpay), obligatoire avec EV_INTEGRATIONS=fake, boucle locale seulement
# EV_DEV_FAKE_SERVICES_URL=http://127.0.0.1:4010/samirpay
# Ports du faux SamirPay et de l'application locale (valeurs par défaut)
# EV_DEV_FAKE_PORT=4010
# EV_DEV_APP_PORT=3000
# Référence du projet d'essai, exigée par npm run seed:dev : https://<référence>.supabase.co
# EV_DEV_PROJECT_REF=
# Mot de passe des comptes de seed:dev : 14 caractères, minuscule, majuscule, chiffre, signe
# EV_DEV_SEED_PASSWORD=
# Adresse du tunnel (https://<nom>.trycloudflare.com), égale à NEXT_PUBLIC_APP_URL pendant les essais au téléphone
# EV_DEV_TUNNEL_URL=
# EV_ESSAI_SIMULATION : posée par npm run essai:start seulement, ne jamais l'écrire ici ni dans .env.local
