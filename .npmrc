# Option gardée au lot 7 (D75). liquid-glass-react, qui l'avait imposée (peer react>=19 alors que le
# projet est en React 18 avec Next 14), est retiré, comme react-leaflet. Mais le lockfile est toujours
# généré avec cette option : sans elle, `npm install --dry-run` ajoute un paquet pair
# (@emnapi/wasi-threads), et `npm ci` refuserait un lockfile désynchronisé. On ne la retire qu'après
# un `npm ci` vert en CI avec un lockfile régénéré sans elle.
legacy-peer-deps=true
