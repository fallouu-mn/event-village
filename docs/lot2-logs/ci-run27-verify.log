              const isPushUssd: boolean = paymentData.is_push_ussd || data.is_push_ussd || false;
        
              // ── Mobile : Deep Link immédiat (Wave OU Orange Money) ──
              if (isMobile && redirectTarget) {
                window.location.href = redirectTarget;
