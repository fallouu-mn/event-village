                    operator: operator === 'om' ? 'ORANGE_MONEY' : operator.toUpperCase(),
                    customerPhone: phoneSanitized,
                  }
                : {
                    targetType,
                    targetId,
                    operator: operator === 'om' ? 'ORANGE_MONEY' : operator.toUpperCase(),
                    customerPhone: phoneSanitized,
                    ...(quantity && quantity > 1 ? { quantity } : {}),
                  };
        
              const response = await fetch(endpoint, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
