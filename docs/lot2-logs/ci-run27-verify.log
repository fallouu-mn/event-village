              if (isPushUssd) {
                setPendingTransactionId(txId);
                setOmRedirectUrl('');
                setScreen('ussd_pending');
                startPolling(txId);
                setIsInitiating(false);
                return;
              }
        
              throw new Error('URL de paiement non reçue. Veuillez réessayer.');
