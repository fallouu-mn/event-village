                    setRedirect({ kind: 'pending', label, opened, statusPath: outcome.statusPagePath, expiresAt: outcome.expiresAt });
                }
                else {
                    setRedirect({ kind: 'settled', label, opened: false, statusPath: outcome.statusPagePath, expiresAt: null });
