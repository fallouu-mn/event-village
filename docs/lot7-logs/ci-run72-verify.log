                ? `Connexion à ${chosenLabel ?? 'l’opérateur'}…`
                : retryRemaining > 0
                    ? `Réessayer dans ${formatDelay(retryRemaining)}`
                    : awaitingQuote
                        ? 'Calcul du total…'
                        : payableAmount
                            ? chosenLabel
                                ? `Payer ${payableAmount} avec ${chosenLabel}`
                                : `Payer ${payableAmount}`
                            : chosenLabel
                                ? `Continuer avec ${chosenLabel}`
                                : 'Continuer vers le paiement';
