                            eventId: props.eventId,
                            items: props.checkoutItems.map(({ categoryId, quantity }) => ({ categoryId, quantity })),
                            operator,
                            payerPhone,
                        },
                    }
                    : {
                        endpoint: '/api/payments/create',
                        body: {
