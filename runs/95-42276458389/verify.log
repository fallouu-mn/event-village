                    setLoadError(null);
                    setRefreshError(null);
                    setPhase('ready');
                    return;
                }
                if (mode === 'initial') {
                    setLoadError(result.message);
                    setPhase('error');
                }
                else {
                    setRefreshError(result.message);
                }
            }, []);
            const refreshEvents = useCallback(() => load('silent'), [load]);
            useEffect(() => {
