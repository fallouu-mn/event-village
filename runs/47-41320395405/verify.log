          | { kind: 'idle' }
          | { kind: 'loading'; key: string }
          | { kind: 'ready'; key: string; quote: CheckoutQuote }
          | { kind: 'error'; key: string; message: string };
        import { useToast } from '@/components/ui/Toast';
