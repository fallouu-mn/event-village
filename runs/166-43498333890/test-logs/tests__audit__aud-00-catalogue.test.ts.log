[AUDIT-CATALOGUE] {"view":"platform_settings_public","owner":"postgres","options":"{security_barrier=true}","def":" SELECT key,\n    value\n   FROM platform_settings s\n  WHERE key = ANY (ARRAY['features.halls_enabled'::text, 'features.tables_enabled'::text, 'features.orders_enabled'::text, 'access.low_stock_threshold'::text, 'finance.service_fee_rate'::text, 'finance.min_paid_price'::text]);"}
