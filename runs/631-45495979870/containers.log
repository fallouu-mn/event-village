	    IF v_withdrawal_delayed AND (v_user IS NOT NULL OR v_phone IS NOT NULL) THEN
	        PERFORM public.notif_enqueue(jsonb_strip_nulls(jsonb_build_object(
	            'type', 'WITHDRAWAL_DELAYED',
	            'key', 'WITHDRAWAL_DELAYED:' || NEW.id::text,
	            'user_id', v_user,
	            'phone', v_phone,
	            'data', v_money
	        )));
	    END IF;
	
	    RETURN NEW;
	END;
	$$
