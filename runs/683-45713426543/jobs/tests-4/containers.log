	-- ----------------------------------------------------------------------------
	DO $$
	DECLARE
	    r record;
	BEGIN
	    FOR r IN
	        SELECT c.oid::regclass AS rel
	          FROM pg_class c
	         WHERE c.relnamespace = 'public'::regnamespace
	           AND c.relkind IN ('r', 'p', 'v', 'm', 'f')
