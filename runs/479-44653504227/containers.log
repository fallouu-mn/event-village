	--    ne s'y ajoute (un droit par défaut global ne se retire pas par schéma).
	-- ----------------------------------------------------------------------------
	ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
	    REVOKE INSERT, UPDATE, DELETE, TRUNCATE ON TABLES FROM anon, authenticated;
