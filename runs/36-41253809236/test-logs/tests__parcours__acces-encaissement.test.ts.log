                    if (serverHasRole(user, 'PARTENAIRE') && !serverHasAnyRole(user, ['ADMIN', 'SUPERADMIN'])) {
                        const { data: partnerRec } = await supabase
                            .from('partners')
                            .select('id')
                            .eq('user_id', user.id)
