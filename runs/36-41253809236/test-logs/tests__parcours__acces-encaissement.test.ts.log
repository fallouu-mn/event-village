                            : '';
        
                        return NextResponse.json({
                            scan_result: 'already_used',
                            message: `Billet déjà scanné${checkedTime ? ` à ${checkedTime}` : ''}.`,
                            ticket_info: {
                                ticket_number: ticket.ticket_number,
                                event_title: eventData?.title,
