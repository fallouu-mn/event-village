                if (serverHasRole(user, 'CONTROLEUR') && !serverHasAnyRole(user, ['ADMIN', 'SUPERADMIN', 'PARTENAIRE'])) {
                    const { data: assignment } = await supabase
                        .from('event_controllers')
                        .select('id, can_accept_cash')
                        .eq('event_id', ticket.event_id)
                        .eq('user_id', user.id)
                        .maybeSingle();
        
                    if (!assignment) {
