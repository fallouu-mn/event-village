	CREATE OR REPLACE FUNCTION public.product_public(p_product_id uuid)
	RETURNS boolean
	LANGUAGE sql
	STABLE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	    SELECT EXISTS (SELECT 1 FROM public.products pr
