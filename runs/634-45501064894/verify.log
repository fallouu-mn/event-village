            if (!clockKnown) {
                return cat.availability === 'LOW' && cat.remainingHint !== null
                    ? { label: cat.remainingHint > 1 ? `Plus que ${cat.remainingHint} places` : 'Plus qu’une place', tone: 'warning' }
