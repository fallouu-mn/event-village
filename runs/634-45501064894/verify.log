                    sessionStorage.removeItem(`${CART_KEY_PREFIX}${eventId}`);
            }
            catch (err) {
                console.warn('[événement] panier gardé illisible (stockage du navigateur indisponible) :', err instanceof Error ? err.message : String(err));
                return null;
            }
            if (!raw)
                return null;
            try {
                const saved: unknown = JSON.parse(raw);
                if (!isRecord(saved) || typeof saved.at !== 'number' || !isRecord(saved.cart))
                    return null;
                if (Date.now() - saved.at > CART_TTL_MS)
                    return null;
                const cart: Record<string, number> = {};
                for (const [categoryId, qty] of Object.entries(saved.cart)) {
