                        setAlreadyRegistered(false);
                    }} placeholder="77 123 45 67" hint="Mobile sénégalais : 70, 75, 76, 77 ou 78. Le code arrive par SMS sur ce numéro." required/>
                                    <Button type="submit" variant="primary" size="lg" fullWidth isLoading={isLoading} leftIcon={<MessageSquareText size={18}/>}>
                                        Recevoir le code par SMS
                                    </Button>
                                </form>)}
        
                            
                            {step === 'profile' && !created && (<form noValidate onSubmit={handleCreateAccount} className="space-y-5">
                                    <div className="flex flex-wrap items-center justify-between gap-2 rounded-2xl border border-border bg-surface-sunken px-4 py-2">
                                        <p className="text-sm text-fg">
                                            Numéro : <span className="whitespace-nowrap font-semibold tabular-nums">{confirmedPhone}</span>
                                        </p>
                                        <Button type="button" variant="ghost" size="sm" onClick={changePhone} disabled={isLoading} leftIcon={<Pencil size={16}/>}>
                                            Modifier le numéro
                                        </Button>
                                    </div>
        
                                    <fieldset className="space-y-3">
                                        <legend id="inscription-otp-titre" className="text-sm font-semibold text-fg">Code reçu par SMS</legend>
                                        <p id="inscription-otp-aide" className="text-sm text-fg-muted">
                                            6 chiffres, envoyés au <span className="whitespace-nowrap tabular-nums">{confirmedPhone}</span>.
                                        </p>
                                        <OtpInput value={otpCode} onChange={(value) => {
                        setOtpCode(value);
                        setCodeError(null);
                    }} disabled={isLoading} hasError={Boolean(codeError)} describedBy={codeError ? 'inscription-otp-aide inscription-otp-erreur' : 'inscription-otp-aide'}/>
                                        {codeError && (<p id="inscription-otp-erreur" role="alert" className="text-sm font-medium text-danger-fg">{codeError}</p>)}
                                        <div className="flex justify-end">
