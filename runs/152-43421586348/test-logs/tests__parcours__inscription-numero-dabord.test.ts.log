                                                {resendIn > 0 ? `Nouveau code dans ${resendIn} s` : 'Recevoir un nouveau code'}
                                            </Button>
                                        </div>
                                    </fieldset>
        
                                    <div className="grid grid-cols-1 gap-4 sm:grid-cols-2">
