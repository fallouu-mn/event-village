===== supabase_db_event-village =====
	    SELECT EXISTS (SELECT 1 FROM public.event_controllers ec WHERE ec.event_id = p_event AND ec.user_id = auth.uid())
	       AND NOT EXISTS (
	        SELECT 1
	          FROM public.events e
	          JOIN public.partners p ON p.id = e.partner_id
	         WHERE e.id = p_event
	           AND p.status::text NOT IN ('VALIDE', 'SUSPENDU')
	    );
	$$;
	REVOKE ALL ON FUNCTION public.controller_assignment_active(uuid) FROM PUBLIC;
	GRANT EXECUTE ON FUNCTION public.controller_assignment_active(uuid) TO anon, authenticated, service_role;
	COMMENT ON FUNCTION public.controller_assignment_active(uuid) IS
	    'Lot 9 quinquies (contre-vérification, point 4) : aide RLS ; vrai si l''appelant est affecté à l''événement et que la fiche partenaire de l''événement est VALIDE ou SUSPENDU.';
	
	-- Recopie de 20261111000003_lot9quater_droits.sql:238-251 ; changement : contrôleur affecté et partenaire seulement si la
	-- fiche de l'événement est VALIDE ou SUSPENDU
	CREATE OR REPLACE FUNCTION public.scan_scanner_authorized(p_scanner uuid, p_event uuid)
	RETURNS boolean
	LANGUAGE sql
	STABLE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	    SELECT EXISTS (SELECT 1 FROM public.users u WHERE u.id = p_scanner AND u.status = 'ACTIF')
	       AND (((EXISTS (SELECT 1 FROM public.event_controllers ec WHERE ec.event_id = p_event AND ec.user_id = p_scanner)
	              OR EXISTS (SELECT 1 FROM public.events e JOIN public.partners p ON p.id = e.partner_id WHERE e.id = p_event AND p.user_id = p_scanner))
	             AND NOT EXISTS (SELECT 1 FROM public.events e JOIN public.partners p ON p.id = e.partner_id
	                              WHERE e.id = p_event AND p.status::text NOT IN ('VALIDE', 'SUSPENDU')))
	         OR EXISTS (SELECT 1 FROM public.user_roles r WHERE r.user_id = p_scanner AND r.role = 'SUPERADMIN')
	         OR (EXISTS (SELECT 1 FROM public.user_roles r WHERE r.user_id = p_scanner AND r.role = 'ADMIN')
	             AND EXISTS (SELECT 1 FROM public.admin_permissions ap WHERE ap.user_id = p_scanner AND ap.permission = 'access.operate')))
	$$;
	
	-- Recopie de 20261103000001_lot6_dette.sql:116-139 ; changement : branche contrôleur par l'aide controller_assignment_active
	-- (affectation de l'appelant ET fiche VALIDE ou SUSPENDU)
	DROP POLICY IF EXISTS "tickets_read" ON public.tickets;
	CREATE POLICY "tickets_read" ON public.tickets
	    FOR SELECT TO authenticated USING (
	        (
	            user_id = auth.uid()
	            OR EXISTS (
	                SELECT 1 FROM public.events e
	                 WHERE e.id = tickets.event_id
	                   AND public.is_partner_owner(e.partner_id)
	            )
	            OR public.is_admin()
	            OR (
	                public.is_controller()
	                AND public.controller_assignment_active(tickets.event_id)
	            )
	        )
	        AND EXISTS (SELECT 1 FROM public.users u
	                     WHERE u.id = auth.uid() AND u.status::text NOT IN ('SUSPENDU', 'SUPPRIME'))
	    );
	
172.18.0.1 2026-11-17 12:58:27.190 UTC [3464] postgres@postgres LOG:  statement: -- ============================================================================
	-- EVENT VILLAGE — LOT 9 QUINQUIES, correctifs de la contre-vérification, point 5 : réservations de salle simultanées
	-- sans blocage mutuel
	-- ============================================================================
	-- Constat (run 177, tests/partner-halls-m7.test.ts, test 2) : deux réservations simultanées de la même salle sur des dates
	--   qui se chevauchent ; l'une est refusée par « deadlock detected » (40P01) au lieu du refus de conflit de calendrier.
	-- Cause : la contrainte d'exclusion no_overlapping_hall_reservations (0009_hall_reservations_exclusion.sql) vérifie le
	--   conflit APRÈS avoir inséré l'entrée d'index. Quand deux insertions concurrentes qui se chevauchent ont toutes deux
	--   inséré leur entrée avant de vérifier, chacune trouve l'entrée de l'autre, en cours, et attend la fin de l'autre
	--   transaction : attente circulaire, PostgreSQL en annule une. Le déclencheur check_hall_availability (0002) ne voit
	--   pas la ligne non validée de l'autre et ne sérialise rien. Aucun déclencheur sur partners n'intervient : le seul
	--   déclencheur de l'insertion, trg_hall_reservations_notify (20261103000006), lit partners et met un avis en file
	--   (notif_enqueue : INSERT … ON CONFLICT DO NOTHING sur une clé propre à la réservation), sans verrou partagé.
	--   Fenêtre étroite : le blocage n'apparaît que si les deux entrées d'index précèdent les deux vérifications (vert aux
	--   runs 174 et 176, rouge au run 177).
	-- Correctif : check_hall_availability prend d'abord un verrou consultatif de transaction propre à la salle
	--   (pg_advisory_xact_lock) : les réservations d'une même salle passent l'une après l'autre ; la seconde attend la fin de
	--   la première, puis sa vérification (instantané neuf : fonction VOLATILE en lecture validée) voit la ligne validée et
	--   lève le refus de conflit de calendrier. La contrainte d'exclusion reste la garantie finale.
	-- Objets : recopie de check_hall_availability (0002_functions.sql:313-327) ; le déclencheur trg_check_hall_conflict
	--   (0002_functions.sql:330-334) est inchangé.
	-- Aucun BEGIN ni COMMIT ; rejouable.
	-- ============================================================================
	
	CREATE OR REPLACE FUNCTION public.check_hall_availability()
	RETURNS TRIGGER
	LANGUAGE plpgsql
	VOLATILE
	AS $$
	BEGIN
	    -- Contre-vérification du lot 9 quinquies (point 5) : une réservation à la fois par salle (fin de transaction)
	    PERFORM pg_advisory_xact_lock(hashtextextended('hall_reservations:' || NEW.hall_id::text, 0));
	    IF EXISTS (
	        SELECT 1 FROM public.hall_reservations
	        WHERE hall_id = NEW.hall_id
	          AND id != COALESCE(NEW.id, '00000000-0000-0000-0000-000000000000'::uuid)
	          AND status IN ('EN_ATTENTE', 'CONFIRMEE')
	          AND NOT (NEW.end_date < start_date OR NEW.start_date > end_date)
	    ) THEN
	        RAISE EXCEPTION 'La salle est déjà réservée pour cette période (dates conflictuelles)';
	    END IF;
	    RETURN NEW;
	END;
	$$;
	
