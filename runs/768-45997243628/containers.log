===== supabase_db_event-village =====
	                              ORDER BY h.weekday, h.opens_at), '[]'::jsonb)
	      INTO v_hours
	      FROM public.venue_opening_hours h WHERE h.venue_id = v.id;
	
	    -- Fenêtres où une heure peut être choisie : horaires des 7 jours, moins les fermetures, de maintenant + préparation
	    -- à 7 jours (même borne que order_quote_compute ; la base refait tous les contrôles au devis)
	    SELECT COALESCE(jsonb_agg(jsonb_build_array(to_char(lower(r), 'YYYY-MM-DD"T"HH24:MI'), to_char(upper(r), 'YYYY-MM-DD"T"HH24:MI'))
	                              ORDER BY lower(r)), '[]'::jsonb)
	      INTO v_windows
	      FROM unnest((
	            (SELECT range_agg(public.venue_range(g.day::date, h.opens_at, h.closes_at))
	               FROM generate_series((v_today - 1)::timestamp, (v_today + 7)::timestamp, interval '1 day') AS g(day)
	               JOIN public.venue_opening_hours h ON h.venue_id = v.id AND h.weekday = EXTRACT(ISODOW FROM g.day))
	            - COALESCE((SELECT range_agg(c.period) FROM public.venue_closures c
	                         WHERE c.venue_id = v.id AND c.cancelled_at IS NULL AND c.ends_at > v_now), '{}'::tsmultirange))
	           * tsmultirange(tsrange(v_now + make_interval(mins => v_prep), v_now + interval '7 days', '[)'))) AS r;
	
	    -- « Tout de suite » : ouvert pendant toute la préparation (règle de order_quote_compute) et aucune fermeture
	    v_asap := public.venue_open_covers(v.id, tsrange(v_now, v_now + make_interval(mins => v_prep + 1), '[)'))
	              AND NOT public.venue_closed_during(v.id, tsrange(v_now, v_now + make_interval(mins => v_prep + 1), '[)'));
	
	    -- Produits de l'établissement (retirés exclus) : disponibilité calculée, jamais le stock exact
	    SELECT COALESCE(jsonb_agg(x.item ORDER BY x.daily DESC, x.cat_order, x.cat_name, x.name, x.id), '[]'::jsonb)
	      INTO v_products
	      FROM (
	        SELECT pr.id, pr.name, pr.is_daily_special AS daily,
	               COALESCE(cat.sort_order, 2147483647) AS cat_order, COALESCE(cat.name, '') AS cat_name,
	               jsonb_build_object(
	                   'id', pr.id,
	                   'name', pr.name,
	                   'description', NULLIF(btrim(COALESCE(pr.description, '')), ''),
	                   'price', pr.price,
	                   'image', CASE WHEN cardinality(pr.images) > 0 AND NULLIF(btrim(pr.images[1]), '') IS NOT NULL THEN pr.images[1] END,
	                   'category_id', cat.id,
	                   'availability', CASE
	                       WHEN pr.status::text <> 'DISPONIBLE' THEN pr.status::text
	                       WHEN pr.is_stock_managed AND pr.stock_quantity IS NOT NULL AND pr.stock_quantity <= 0 THEN 'EPUISE'
	                       WHEN pr.is_daily_special AND COALESCE(dp.portions - dp.sold, 0) <= 0 THEN 'EPUISE'
	                       ELSE 'DISPONIBLE' END,
	                   'regulated', pr.is_regulated OR COALESCE(pr.regulated_admin, FALSE),
	                   'in_review', (to_jsonb(pr) ->> 'review_state') IS NOT NULL,
	                   'orderable', pr.status::text = 'DISPONIBLE' AND pr.price = trunc(pr.price)
	                       AND NOT public.product_regulated(pr.id)
	                       AND NOT (pr.is_stock_managed AND pr.stock_quantity IS NOT NULL AND pr.stock_quantity <= 0)
	                       AND NOT (pr.is_daily_special AND COALESCE(dp.portions - dp.sold, 0) <= 0),
	                   'daily', pr.is_daily_special,
	                   'portions_left', CASE WHEN pr.is_daily_special THEN GREATEST(COALESCE(dp.portions - dp.sold, 0), 0) END,
	                   'portions_total', CASE WHEN pr.is_daily_special THEN COALESCE(dp.portions, 0) END,
	                   'options', (SELECT COALESCE(jsonb_agg(jsonb_build_object('id', o.id, 'name', o.name, 'price', o.price_delta)
	                                                         ORDER BY o.sort_order, o.name, o.id), '[]'::jsonb)
	                                 FROM public.product_options o WHERE o.product_id = pr.id AND o.is_active)
	               ) AS item
	          FROM public.products pr
	          LEFT JOIN public.product_categories cat ON cat.id = pr.category_id AND cat.is_active AND cat.partner_id = pr.partner_id
	          LEFT JOIN public.product_daily_portions dp ON dp.product_id = pr.id AND dp.day = v_today
	         WHERE pr.venue_id = v.id AND pr.partner_id = v.partner_id
	           AND (to_jsonb(pr) ->> 'archived_at') IS NULL
	      ) x;
	
	    -- Catégories qui ont au moins un produit dans la carte
	    SELECT COALESCE(jsonb_agg(jsonb_build_object('id', c.id, 'name', c.name) ORDER BY c.sort_order, c.name, c.id), '[]'::jsonb)
	      INTO v_cats
	      FROM public.product_categories c
	     WHERE c.is_active AND c.partner_id = v.partner_id
	       AND EXISTS (SELECT 1 FROM public.products pr WHERE pr.category_id = c.id AND pr.venue_id = v.id AND (to_jsonb(pr) ->> 'archived_at') IS NULL);
	
	    -- Zones de livraison actives (non retirées), si la livraison est proposée
	    SELECT COALESCE(jsonb_agg(jsonb_build_object('id', z.id, 'name', z.name, 'fee', z.fee, 'min_order', z.min_order)
	                              ORDER BY z.sort_order, z.name, z.id), '[]'::jsonb)
	      INTO v_zones
	      FROM public.order_delivery_zones z
	     WHERE z.venue_id = v.id AND z.is_active AND (to_jsonb(z) ->> 'archived_at') IS NULL AND 'LIVRAISON' = ANY (v.order_modes);
	
	    -- Tables actives, si la commande sur place est proposée (liste ; QR de table plus tard)
	    SELECT COALESCE(jsonb_agg(jsonb_build_object('id', t.id, 'label', t.table_number, 'zone', rz.name)
	                              ORDER BY rz.name NULLS FIRST, length(t.table_number), t.table_number, t.id), '[]'::jsonb)
	      INTO v_spots
	      FROM public.restaurant_tables t
	      LEFT JOIN public.restaurant_zones rz ON rz.id = t.zone_id
	     WHERE t.venue_id = v.id AND t.is_active AND 'SUR_PLACE' = ANY (v.order_modes);
	
	    RETURN jsonb_build_object(
	        'venue', jsonb_build_object('id', v.id, 'name', v.name, 'kind', v.kind, 'city', v.city, 'address', v.address,
	                                    'description', NULLIF(btrim(COALESCE(v.description, '')), ''), 'photos', to_jsonb(COALESCE(v.photos, ARRAY[]::text[]))),
	        'ordering', jsonb_build_object(
	            'modes', to_jsonb(v.order_modes),
	            'deposit_percent', CASE WHEN v.order_deposit_allowed
	                                    THEN COALESCE(v.order_deposit_percent, public.fin_setting_num('orders.deposit_default_percent')::int) END,
	            'pay_on_handover', v.order_pay_on_handover,
	            'prep_minutes', v_prep,
	            'service_fee_rate', public.fin_setting_num('orders.service_fee_rate'),
	            'asap_available', v_asap,
	            'now', to_char(v_now, 'YYYY-MM-DD"T"HH24:MI'),
	            'windows', v_windows),
	        'hours', v_hours,
	        'zones', v_zones,
	        'spots', v_spots,
	        'categories', v_cats,
	        'products', v_products);
	END;
	$$;
	
	REVOKE ALL ON FUNCTION public.order_venue_menu(uuid) FROM PUBLIC, anon, authenticated;
	GRANT EXECUTE ON FUNCTION public.order_venue_menu(uuid) TO service_role;
	
	-- ----------------------------------------------------------------------------
	-- 2. Lecture REST des produits : établissement listé seulement (plus la propriétaire et l'administration)
	-- ----------------------------------------------------------------------------
	-- products_read (dernière définition : 0003_rls.sql:237-238) ; changement : un produit DISPONIBLE n'est public que s'il
	-- appartient à un établissement listé (actif, validé, partenaire VALIDE) et n'est pas retiré
	DROP POLICY IF EXISTS "products_read" ON public.products;
	CREATE POLICY "products_read" ON public.products
	    FOR SELECT USING (
	        (status = 'DISPONIBLE' AND venue_id IS NOT NULL AND public.listed_venue(venue_id)
	         AND (to_jsonb(products.*) ->> 'archived_at') IS NULL)
	        OR public.is_partner_owner(partner_id)
	        OR public.is_admin()
	    );
	
	-- product_options_read (dernière définition : 20261130000002_l12a_catalogue.sql:425-427) ; changement : conditions en
	-- clair, supplément actif pour le public
	DROP POLICY IF EXISTS "product_options_read" ON public.product_options;
	CREATE POLICY "product_options_read" ON public.product_options
	    FOR SELECT USING (EXISTS (
	        SELECT 1 FROM public.products pr
	         WHERE pr.id = product_options.product_id
	           AND ((product_options.is_active AND pr.status = 'DISPONIBLE' AND pr.venue_id IS NOT NULL AND public.listed_venue(pr.venue_id)
	                 AND (to_jsonb(pr) ->> 'archived_at') IS NULL)
	                OR public.is_partner_owner(pr.partner_id)
	                OR public.is_admin())));
	
	-- product_daily_portions_read (dernière définition : 20261130000002_l12a_catalogue.sql:428-430) ; changement : mêmes
	-- conditions en clair
	DROP POLICY IF EXISTS "product_daily_portions_read" ON public.product_daily_portions;
	CREATE POLICY "product_daily_portions_read" ON public.product_daily_portions
	    FOR SELECT USING (EXISTS (
	        SELECT 1 FROM public.products pr
	         WHERE pr.id = product_daily_portions.product_id
	           AND ((pr.status = 'DISPONIBLE' AND pr.venue_id IS NOT NULL AND public.listed_venue(pr.venue_id)
	                 AND (to_jsonb(pr) ->> 'archived_at') IS NULL)
	                OR public.is_partner_owner(pr.partner_id)
	                OR public.is_admin())));
	
172.18.0.1 2026-11-27 12:20:13.322 UTC [474] postgres@postgres LOG:  statement: -- ============================================================================
	-- EVENT VILLAGE — LOT 12b, migration 03 : prix changé, double clic et rejeu (commande et paiement)
	-- ============================================================================
	-- Même règle que les tables d'un événement (contre-vérification du lot 11c-b, lib/event-tables/event-tables.server.ts
	-- :140-153, :211-216, :254-262) : l'écran envoie le total qu'il affiche ; si la base calcule un autre montant, rien n'est
	-- créé et le client voit le nouveau prix. Ici la comparaison est faite DANS la transaction de la base (aucune course
	-- possible entre la comparaison et la création, aucune commande ni aucun paiement créé puis annulé).
	--  1. orders.client_request_key : clé d'idempotence de la demande du client (8 à 128 caractères), unique par client ;
	--     posée seulement par order_create_checked ;
	--  2. order_create_checked(p) : enveloppe de order_create (aucune recopie) : verrous de l'établissement puis du client
	--     (même ordre que order_create : aucun interblocage), demande déjà reçue avec la même clé → la même commande
	--     (duplicate) ; sinon order_create dans un sous-bloc : si le total (expected_total) ou le montant à payer maintenant
	--     (expected_to_pay) affichés ne correspondent plus au devis de la base, le sous-bloc est annulé (commande, lignes,
	--     stock et portions rendus) et le refus ORDER_PRICE_CHANGED rend les nouveaux montants ;
	--  3. order_payment_start(p) : enveloppe de order_payment_create (aucune recopie) : clé d'idempotence du paiement
	--     (payments.client_idempotency_key, index unique existant uq_payments_client_idempotency) → même paiement
	--     (duplicate) ; montant affiché (expected_amount) différent du montant de la base → sous-bloc annulé, aucun paiement
	--     créé, refus ORDER_PRICE_CHANGED avec le nouveau montant.
	-- Toutes réservées au rôle de service (routes serveur). Rejouable : ADD COLUMN IF NOT EXISTS, index IF NOT EXISTS,
	-- CREATE OR REPLACE, REVOKE et GRANT idempotents. Aucun BEGIN ni COMMIT.
	-- ============================================================================
	
	-- ----------------------------------------------------------------------------
	-- 1. Clé d'idempotence d'une commande
	-- ----------------------------------------------------------------------------
	ALTER TABLE public.orders ADD COLUMN IF NOT EXISTS client_request_key TEXT;
	ALTER TABLE public.orders DROP CONSTRAINT IF EXISTS orders_client_request_key_chk;
	ALTER TABLE public.orders ADD CONSTRAINT orders_client_request_key_chk CHECK (
	    client_request_key IS NULL OR char_length(client_request_key) BETWEEN 8 AND 128);
	CREATE UNIQUE INDEX IF NOT EXISTS uq_orders_client_request_key
	    ON public.orders (client_id, client_request_key) WHERE client_request_key IS NOT NULL;
	COMMENT ON COLUMN public.orders.client_request_key IS
	    'Lot 12b : clé d''idempotence de la demande de commande (en-tête Idempotency-Key), unique par client : un double clic ou un rejeu rend la même commande.';
	
	-- Montant affiché lu dans la demande : nombre entier positif, sinon NULL (aucune comparaison)
	CREATE OR REPLACE FUNCTION private.order_expected_amount(p_value jsonb)
	RETURNS numeric
	LANGUAGE sql
	IMMUTABLE
	SET search_path = public
	AS $$
	    SELECT CASE WHEN jsonb_typeof(p_value) = 'number' AND (p_value #>> '{}')::numeric >= 0
	                     AND (p_value #>> '{}')::numeric <= 100000000 AND (p_value #>> '{}')::numeric = trunc((p_value #>> '{}')::numeric)
	                THEN (p_value #>> '{}')::numeric END;
	$$;
	
	-- ----------------------------------------------------------------------------
	-- 2. Créer une commande au prix affiché
	-- ----------------------------------------------------------------------------
	CREATE OR REPLACE FUNCTION public.order_create_checked(p jsonb)
	RETURNS jsonb
	LANGUAGE plpgsql
	VOLATILE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	DECLARE
	    v_client   uuid := public.try_uuid(p->>'client_id');
	    v_venue_id uuid := public.try_uuid(p->>'venue_id');
	    v_key      text := NULLIF(btrim(COALESCE(p->>'client_request_key', '')), '');
	    v_total    numeric := private.order_expected_amount(p->'expected_total');
	    v_now      numeric := private.order_expected_amount(p->'expected_to_pay');
	    v_existing uuid;
	    r          jsonb;
	    v_seen     jsonb;
	BEGIN
	    IF v_key IS NOT NULL AND char_length(v_key) NOT BETWEEN 8 AND 128 THEN
	        RETURN jsonb_build_object('ok', false, 'code', 'INVALID_REQUEST_KEY', 'message', 'Demande illisible : rechargez la page et réessayez.');
	    END IF;
	    -- Mêmes verrous, dans le même ordre, que order_create (verrous de transaction, repris sans attente par order_create)
	    IF v_venue_id IS NOT NULL AND v_client IS NOT NULL THEN
	        PERFORM public.order_venue_lock(v_venue_id);
	        PERFORM public.order_client_lock(v_client);
	    END IF;
	    IF v_key IS NOT NULL AND v_client IS NOT NULL THEN
	        SELECT id INTO v_existing FROM public.orders WHERE client_id = v_client AND client_request_key = v_key;
	        IF FOUND THEN
	            RETURN jsonb_build_object('ok', true, 'duplicate', true, 'order_id', v_existing);
	        END IF;
	    END IF;
	    BEGIN
	        r := public.order_create(p);
	        IF (r->>'ok')::boolean THEN
	            IF (v_total IS NOT NULL AND (r->>'goods_total')::numeric + (r->>'first_fee')::numeric <> v_total)
	               OR (v_now IS NOT NULL AND (r->>'to_pay_now')::numeric <> v_now) THEN
	                v_seen := jsonb_build_object('total', (r->>'goods_total')::numeric + (r->>'first_fee')::numeric,
	                                             'to_pay_now', (r->>'to_pay_now')::numeric, 'goods_total', (r->>'goods_total')::numeric);
	                RAISE EXCEPTION USING ERRCODE = 'OR412', MESSAGE = 'ORDER_PRICE_CHANGED';
	            END IF;
	            IF v_key IS NOT NULL THEN
	                PERFORM set_config('event_village.order_flow', 'on', true);
	                UPDATE public.orders SET client_request_key = v_key WHERE id = (r->>'order_id')::uuid;
	            END IF;
	        END IF;
	    EXCEPTION WHEN SQLSTATE 'OR412' THEN
	        -- Sous-bloc annulé : ni commande, ni lignes, ni stock ou portions pris, ni journal, ni avis
	        RETURN jsonb_build_object('ok', false, 'code', 'ORDER_PRICE_CHANGED',
	            'message', 'Le prix de votre commande a changé. Vérifiez avant de payer.') || v_seen;
	    END;
	    RETURN r;
	END;
	$$;
	
	-- ----------------------------------------------------------------------------
	-- 3. Lancer le paiement d'une commande au montant affiché
	-- ----------------------------------------------------------------------------
	CREATE OR REPLACE FUNCTION public.order_payment_start(p jsonb)
	RETURNS jsonb
	LANGUAGE plpgsql
	VOLATILE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	DECLARE
	    v_client   uuid := public.try_uuid(p->>'client_id');
	    v_key      text := NULLIF(btrim(COALESCE(p->>'client_idempotency_key', '')), '');
	    v_expected numeric := private.order_expected_amount(p->'expected_amount');
	    v_existing uuid;
	    v_amount   numeric;
	    r          jsonb;
	BEGIN
	    IF v_key IS NOT NULL AND char_length(v_key) NOT BETWEEN 8 AND 128 THEN
	        RETURN jsonb_build_object('ok', false, 'code', 'INVALID_REQUEST_KEY', 'message', 'Demande illisible : rechargez la page et réessayez.');
	    END IF;
	    IF v_key IS NOT NULL AND v_client IS NOT NULL THEN
	        PERFORM pg_advisory_xact_lock(hashtextextended('order_payment_key:' || v_client::text || ':' || v_key, 0));
	        SELECT id INTO v_existing FROM public.payments WHERE client_id = v_client AND client_idempotency_key = v_key;
	        IF FOUND THEN
	            RETURN jsonb_build_object('ok', true, 'duplicate', true, 'payment_id', v_existing);
	        END IF;
	    END IF;
	    BEGIN
	        r := public.order_payment_create(p);
	        IF (r->>'ok')::boolean THEN
	            IF v_expected IS NOT NULL AND (r->>'amount')::numeric <> v_expected THEN
	                v_amount := (r->>'amount')::numeric;
	                RAISE EXCEPTION USING ERRCODE = 'OR412', MESSAGE = 'ORDER_PRICE_CHANGED';
	            END IF;
	            IF v_key IS NOT NULL THEN
	                UPDATE public.payments SET client_idempotency_key = v_key WHERE id = (r->>'payment_id')::uuid;
	            END IF;
	        END IF;
	    EXCEPTION WHEN SQLSTATE 'OR412' THEN
	        -- Sous-bloc annulé : aucun paiement, aucun journal
	        RETURN jsonb_build_object('ok', false, 'code', 'ORDER_PRICE_CHANGED', 'amount', v_amount,
	            'message', 'Le montant à payer a changé. Vérifiez avant de payer.');
	    END;
	    RETURN r;
	END;
	$$;
	
	REVOKE ALL ON FUNCTION private.order_expected_amount(jsonb) FROM PUBLIC, anon, authenticated, service_role;
	REVOKE ALL ON FUNCTION public.order_create_checked(jsonb) FROM PUBLIC, anon, authenticated;
	REVOKE ALL ON FUNCTION public.order_payment_start(jsonb) FROM PUBLIC, anon, authenticated;
	GRANT EXECUTE ON FUNCTION public.order_create_checked(jsonb) TO service_role;
	GRANT EXECUTE ON FUNCTION public.order_payment_start(jsonb) TO service_role;
	
