                fingerprint: string;
            } | null>(null);
            const keyFor = useCallback((fingerprint: string): string => {
                if (!attemptRef.current || attemptRef.current.fingerprint !== fingerprint) {
                    attemptRef.current = { key: newIdempotencyKey(), fingerprint };
                }
