                      <div className="flex-1 min-w-0 space-y-1.5">
                        <p className="text-xs font-bold text-red-800 dark:text-red-200">{failureTitle(failure)}</p>
                        {failure.problems.length > 0 ? (<ul className="space-y-1">
                            {failure.problems.map((problem, index) => {
                                const label = categoryLabel(problem.categoryId);
                                return (<li key={`${problem.categoryId ?? 'panier'}-${problem.code}-${index}`} className="text-xs text-red-700 dark:text-red-300 leading-relaxed">
                                  {label && <span className="font-bold">{label} : </span>}
                                  {problem.message}
                                </li>);
