                            })}
                          </ul>) : (<p className="text-xs text-red-700 dark:text-red-300 leading-relaxed">{failure.message}</p>)}
                        {failure.httpStatus === 401 && (<Link href={`/login?redirect=${encodeURIComponent(pathname)}`} className="inline-flex items-center gap-1.5 text-xs font-bold text-red-700 dark:text-red-300 underline underline-offset-2">
                            <LogIn size={13} aria-hidden="true"/> Se reconnecter
