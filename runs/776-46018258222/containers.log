	            'prep_minutes', v_prep,
	            'service_fee_rate', public.fin_setting_num('orders.service_fee_rate'),
	            'asap_available', v_asap,
	            'closed_until', to_char(v_closed_until, 'YYYY-MM-DD"T"HH24:MI'),
	            'now', to_char(v_now, 'YYYY-MM-DD"T"HH24:MI'),
	            'windows', v_windows),
	        'hours', v_hours,
	        'zones', v_zones,
	        'spots', v_spots,
	        'categories', v_cats,
	        'products', v_products);
	END;
	$$
