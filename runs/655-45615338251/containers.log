	     WHERE c.event_id = r.event_id AND c.changed_at > r.bought_at
	     ORDER BY c.changed_at, c.id
	     LIMIT 1;
	    RETURN v_base IS NOT NULL AND v_start - v_base > interval '24 hours';
	END;
