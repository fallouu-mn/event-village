                fullWidth
                onClick={() => void signOut()}
                leftIcon={<LogOut size={18} aria-hidden="true" />}
                className="border-danger-border text-danger-fg hover:bg-danger-bg"
              >
                Se déconnecter
              </Button>
            </div>
          );
        }
        
