                : 'Impossible de charger la fiche. Vérifiez votre connexion, puis réessayez.';
              if (silent) {
                toast.error('La fiche n’a pas pu être actualisée. Rechargez la page pour voir son état actuel.');
                return;
              }
              setErrorMessage(message);
              setPhase('error');
            }
