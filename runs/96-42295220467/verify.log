                    {shown.map((evt, i) => (<li key={evt.id}>
                        <EventCard id={evt.id} title={evt.title} subtitle={evt.subtitle} imageUrl={evt.imageUrl} dateFormatted={evt.dateFormatted} dayNumber={evt.dayNumber} monthShort={evt.monthShort} timeFormatted={evt.timeFormatted} venue={evt.venue} city={evt.city} categoryLabel={evt.categoryLabel} price={evt.price} priority={i < 2}/>
                      </li>))}
