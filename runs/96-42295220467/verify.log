                            : 'border-border bg-surface text-fg hover:border-border-strong hover:bg-surface-sunken')}>
                        {c.label}
                      </button>);
                })}
                </div>
        
                {refreshError && phase === 'ready' && (<StatusBanner tone="warning" announce="alert" title="La liste n’a pas pu être mise à jour" action={(<Button variant="secondary" size="sm" onClick={() => void refreshEvents()} leftIcon={<RefreshCw size={16}/>}>
