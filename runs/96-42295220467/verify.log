                    return (<button key={c.id} type="button" aria-pressed={active} onClick={() => setCategory(c.id)} className={cn('inline-flex min-h-11 cursor-pointer items-center rounded-full border px-4 text-sm font-semibold transition-colors duration-200', 'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-surface', active
