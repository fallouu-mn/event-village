                        return (<div key={ev.id} className="rounded-2xl bg-white dark:bg-zinc-900 border border-slate-200 dark:border-zinc-800 overflow-hidden shadow-sm hover:border-[#FF5722]/40 transition-all flex flex-col justify-between">
                                        <div>
                                            
                                            <div className="relative h-44 bg-slate-100 dark:bg-zinc-800 flex items-center justify-center overflow-hidden">
                                                {ev.image_url ? (<Image src={ev.image_url} alt={ev.title} fill className="object-cover" sizes="(max-width: 768px) 100vw, 50vw"/>) : (<div className="text-center p-4">
                                                        <Calendar className="w-10 h-10 text-slate-400 mx-auto mb-2"/>
                                                        <span className="text-xs text-slate-400 font-medium">Image non définie</span>
                                                    </div>)}
                                                <div className="absolute top-3 right-3">
