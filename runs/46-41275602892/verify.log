                return acc + catSold;
            }, 0);
            const totalRevenue = events.reduce((acc, ev) => {
                const catRev = ev.ticket_categories?.reduce((s, c) => s + (c.sold_quantity || 0) * Number(c.price || 0), 0) || 0;
                return acc + catRev;
            }, 0);
            return (<div className="p-6 max-w-7xl mx-auto space-y-8">
                    
