	      LEFT JOIN public.event_zones z ON z.id = t.zone_id
	     WHERE b.event_id = v_event AND b.status = 'ACTIVE';
	    RETURN jsonb_build_object('ok', true, 'event_id', v_event, 'items', v_items, 'read_at', now());
	END;
