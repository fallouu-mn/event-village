            total_quantity: 'Quantité mise en vente',
            max_per_order: 'Maximum de billets par commande',
            sale_start: 'Début de la vente',
            sale_end: 'Fin de la vente',
            sale_online: 'Vendue en ligne',
            sale_counter: 'Vendue au guichet',
