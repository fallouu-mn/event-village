        function readEditLocks(v: unknown): EditLocks | null {
            if (!v || typeof v !== 'object') return null;
            const r = v as Record<string, unknown>;
            const n = (x: unknown): number => (typeof x === 'number' && Number.isFinite(x) ? x : Number(x) || 0);
