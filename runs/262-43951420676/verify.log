                            : 'Les informations saisies pour cette nouvelle catégorie seront perdues.'}
                        confirmLabel={deleting?.draft.id ? 'Supprimer' : 'Abandonner'}
                        cancelLabel="Garder la catégorie"
                        variant="danger"
                    />
                </div>
            );
        }
        
