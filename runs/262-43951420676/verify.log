                        const reply = await sendJson<{ message?: string }>(path, pending.kind === 'clear-invitation' ? 'DELETE' : 'POST', withReason());
                        toast.success(reply.message ?? 'C’est fait.');
                    }
                    setPending(null);
                    await reload();
                } catch (err) {
