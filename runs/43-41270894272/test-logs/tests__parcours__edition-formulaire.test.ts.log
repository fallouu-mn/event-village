        export type EventStatus = 'BROUILLON' | 'EN_ATTENTE' | 'VALIDE' | 'PUBLIE' | 'SUSPENDU' | 'TERMINE' | 'ANNULE';
        
        export interface ProgramItem {
            id: string;
            time: string;
            title: string;
            artistOrSpeaker?: string;
            description?: string;
        }
        
        export interface PracticalInfo {
