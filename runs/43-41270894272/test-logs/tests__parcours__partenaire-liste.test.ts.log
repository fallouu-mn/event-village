                                                            Modifier
                                                        </Button>
                                                    </Link>
                                                </div>)}
        
                                            {ev.status === 'PUBLIE' && (<div className="flex items-center gap-2 w-full">
                                                    <Button size="sm" variant="primary" onClick={() => setQuotaModalEvent(ev)} className="text-xs flex-1 flex items-center justify-center gap-1.5 shadow-xs">
                                                        <Ticket className="w-3.5 h-3.5"/>
                                                        Quotas & Stock
