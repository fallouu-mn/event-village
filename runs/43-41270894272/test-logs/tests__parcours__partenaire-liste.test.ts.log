            id: string;
            title: string;
            description: string | null;
            start_date: string;
            start_time: string;
            location: string;
            city: string | null;
            status: 'BROUILLON' | 'EN_ATTENTE' | 'VALIDE' | 'PUBLIE' | 'SUSPENDU' | 'TERMINE';
            image_url: string | null;
            capacity: number | null;
            created_at: string;
            ticket_categories?: Array<{
                id: string;
                name: string;
                price: number;
                total_quantity: number;
                sold_quantity: number;
                is_active?: boolean;
                is_visible?: boolean;
