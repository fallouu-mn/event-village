 precision, "location" text, "longitude" double precision, "notify_version" integer, "partner_id" uuid, "practical_info" jsonb, "program" jsonb, "services" jsonb, "slug" text, "start_date" date, "start_time" time without time zone, "status" public.event_status, "title" text, "updated_at" timestamp with time zone) ) pgrst_body WHERE set_config('pgrst.inserted', (coalesce(nullif(current_setting('pgrst.inserted', true), '')::int, 0) + 1)::text, true) <> '0' ON CONFLICT("id") DO UPDATE SET "capacity" = EXCLUDED."capacity", "category" = EXCLUDED."category", "city" = EXCLUDED."city", "created_at" = EXCLUDED."created_at", "description" = EXCLUDED."description", "end_date" = EXCLUDED."end_date", "end_time" = EXCLUDED."end_time", "ended_unpublished" = EXCLUDED."ended_unpublished", "featured_until" = EXCLUDED."featured_until", "gallery_urls" = EXCLUDED."gallery_urls", "id" = EXCLUDED."id", "image_url" = EXCLUDED."image_url", "is_featured" = EXCLUDED."is_featured", "latitude" = EXCLUDED."latitude", "location" = EXCLUDED."location", "longitude" = EXCLUDED."longitude", "notify_version" = EXCLUDED."notify_version", "partner_id" = EXCLUDED."partner_id", "practical_info" = EXCLUDED."practical_info", "program" = EXCLUDED."program", "services" = EXCLUDED."services", "slug" = EXCLUDED."slug", "start_date" = EXCLUDED."start_date", "start_time" = EXCLUDED."start_time", "status" = EXCLUDED."status", "title" = EXCLUDED."title", "updated_at" = EXCLUDED."updated_at"WHERE set_config('pgrst.inserted', (coalesce(nullif(current_setting('pgrst.inserted', true), '')::int, 0) - 1)::text, true) <> '-1' RETURNING "public"."events"."id", "public"."events"."status") SELECT '' AS total_result_set, pg_catalog.count(_postgrest_t) AS page_total, array[]::text[] AS header, coalesce(json_agg(_postgrest_t), '[]') AS body, nullif(current_setting('response.headers', true), '') AS response_headers, nullif(current_setting('response.status', true), '') AS response_status, nullif(current_setting('pgrst.inserted', true),'')::int AS response_inserted FROM (SELECT "events"."id", "events"."status" FROM "pgrst_source" AS "events"   ) _postgrest_t
