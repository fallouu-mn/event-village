[AUDIT-CATALOGUE] Définition des aides exécutables de public (hors fonctions d’extensions) — 7 ligne(s)
[AUDIT-CATALOGUE] {"name":"auth_user_role","def":"CREATE OR REPLACE FUNCTION public.auth_user_role()\n RETURNS user_role\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT CASE\n        WHEN NOT EXISTS (SELECT 1 FROM public.users u WHERE u.id = auth.uid() AND u.status::text = 'ACTIF') THEN NULL\n        WHEN public.has_role('SUPERADMIN') THEN 'SUPERADMIN'::user_role\n        WHEN public.has_role('ADMIN')      THEN 'ADMIN'::user_role\n        WHEN public.has_role('PARTENAIRE') THEN 'PARTENAIRE'::user_role\n        WHEN public.has_role('CONTROLEUR') THEN 'CONTROLEUR'::user_role\n        ELSE 'CLIENT'::user_role\n    END;\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"has_role","def":"CREATE OR REPLACE FUNCTION public.has_role(p_role user_role)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT EXISTS (\n        SELECT 1\n          FROM public.user_roles r\n          JOIN public.users u ON u.id = r.user_id\n         WHERE r.user_id = auth.uid()\n           AND r.role = p_role\n           AND u.status::text = 'ACTIF'\n    );\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_admin","def":"CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT COALESCE((public.has_role('ADMIN') OR public.has_role('SUPERADMIN'))\n                    AND EXISTS (SELECT 1 FROM public.users u WHERE u.id = auth.uid() AND u.status::text = 'ACTIF'), FALSE);\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_controller","def":"CREATE OR REPLACE FUNCTION public.is_controller()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT COALESCE((public.has_role('CONTROLEUR') OR public.has_role('ADMIN') OR public.has_role('SUPERADMIN'))\n                    AND EXISTS (SELECT 1 FROM public.users u WHERE u.id = auth.uid() AND u.status::text = 'ACTIF'), FALSE);\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_partner_owner","def":"CREATE OR REPLACE FUNCTION public.is_partner_owner(p_partner_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT EXISTS (\n        SELECT 1\n          FROM public.partners p\n          JOIN public.users u ON u.id = p.user_id\n         WHERE p.id = p_partner_id\n           AND p.user_id = auth.uid()\n           AND u.status::text = 'ACTIF'\n    );\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_superadmin","def":"CREATE OR REPLACE FUNCTION public.is_superadmin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT COALESCE(public.has_role('SUPERADMIN')\n                    AND EXISTS (SELECT 1 FROM public.users u WHERE u.id = auth.uid() AND u.status::text = 'ACTIF'), FALSE);\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"ticket_category_private_read","def":"CREATE OR REPLACE FUNCTION public.ticket_category_private_read(p_event uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT (EXISTS (SELECT 1 FROM public.events e\n                     WHERE e.id = p_event AND public.is_partner_owner(e.partner_id))\n            OR public.is_admin())\n       AND EXISTS (SELECT 1 FROM public.users u\n                    WHERE u.id = auth.uid() AND u.status::text NOT IN ('SUSPENDU', 'SUPPRIME'))\n$function$\n"}

