[AUDIT-CATALOGUE] {"name":"interval_dist","def":"CREATE OR REPLACE FUNCTION public.interval_dist(interval, interval)\n RETURNS interval\n LANGUAGE c\n IMMUTABLE PARALLEL SAFE STRICT\nAS '$libdir/btree_gist', $function$interval_dist$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_admin","def":"CREATE OR REPLACE FUNCTION public.is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT COALESCE((public.has_role('ADMIN') OR public.has_role('SUPERADMIN'))\n                    AND EXISTS (SELECT 1 FROM public.users u WHERE u.id = auth.uid() AND u.status::text = 'ACTIF'), FALSE);\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_controller","def":"CREATE OR REPLACE FUNCTION public.is_controller()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT COALESCE(has_role('CONTROLEUR') OR has_role('ADMIN') OR has_role('SUPERADMIN'), FALSE);\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_partner_owner","def":"CREATE OR REPLACE FUNCTION public.is_partner_owner(p_partner_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT EXISTS (\n        SELECT 1 FROM partners\n        WHERE id = p_partner_id\n          AND user_id = auth.uid()\n    );\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"is_superadmin","def":"CREATE OR REPLACE FUNCTION public.is_superadmin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT COALESCE(public.has_role('SUPERADMIN')\n                    AND EXISTS (SELECT 1 FROM public.users u WHERE u.id = auth.uid() AND u.status::text = 'ACTIF'), FALSE);\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"oid_dist","def":"CREATE OR REPLACE FUNCTION public.oid_dist(oid, oid)\n RETURNS oid\n LANGUAGE c\n IMMUTABLE PARALLEL SAFE STRICT\nAS '$libdir/btree_gist', $function$oid_dist$function$\n"}
[AUDIT-CATALOGUE] {"name":"ticket_category_private_read","def":"CREATE OR REPLACE FUNCTION public.ticket_category_private_read(p_event uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\n    SELECT (EXISTS (SELECT 1 FROM public.events e\n                     WHERE e.id = p_event AND public.is_partner_owner(e.partner_id))\n            OR public.is_admin())\n       AND EXISTS (SELECT 1 FROM public.users u\n                    WHERE u.id = auth.uid() AND u.status::text NOT IN ('SUSPENDU', 'SUPPRIME'))\n$function$\n"}
[AUDIT-CATALOGUE] {"name":"time_dist","def":"CREATE OR REPLACE FUNCTION public.time_dist(time without time zone, time without time zone)\n RETURNS interval\n LANGUAGE c\n IMMUTABLE PARALLEL SAFE STRICT\nAS '$libdir/btree_gist', $function$time_dist$function$\n"}
