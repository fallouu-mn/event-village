172.18.0.1 2026-11-20 23:47:20.251 UTC [248] postgres@postgres LOG:  execute <unnamed>: GRANT EXECUTE ON FUNCTION public.event_favorite_set(uuid, uuid, boolean) TO service_role
172.18.0.1 2026-11-20 23:47:20.251 UTC [248] postgres@postgres LOG:  execute <unnamed>: -- Favoris encore publics du compte donné par la route serveur, du plus récent au plus ancien (500 au plus).
	CREATE OR REPLACE FUNCTION public.event_favorite_list(p_user uuid, p_limit integer)
	RETURNS TABLE (event_id uuid, created_at timestamptz)
	LANGUAGE sql
	STABLE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	    SELECT f.event_id, f.created_at
	      FROM public.event_favorites f
	      JOIN public.events e ON e.id = f.event_id
	     WHERE p_user IS NOT NULL
	       AND f.user_id = p_user
	       AND e.status::text IN ('PUBLIE', 'SUSPENDU', 'ANNULE', 'TERMINE')
	       AND e.ended_unpublished IS NOT TRUE
	     ORDER BY f.created_at DESC, f.event_id
	     LIMIT LEAST(GREATEST(COALESCE(p_limit, 500), 1), 500);
	$$
