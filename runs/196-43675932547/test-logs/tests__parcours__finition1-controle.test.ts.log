          PARTENAIRE: 'Partenaire',
          CONTROLEUR: 'Contrôleur',
          CLIENT: 'Client',
        };
        
        function roleLabel(role: string | null | undefined): string {
          return (role && ROLE_LABELS[role]) || 'Client';
        }
        
