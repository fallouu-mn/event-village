[AUDIT-CATALOGUE] {"view":"events_public_status","owner":"postgres","options":"{security_barrier=true}","def":" SELECT id,\n    status\n   FROM events e\n  WHERE (status::text = ANY (ARRAY['PUBLIE'::text, 'SUSPENDU'::text, 'ANNULE'::text, 'TERMINE'::text])) AND NOT ended_unpublished;"}
[AUDIT-CATALOGUE] {"view":"platform_settings_public","owner":"postgres","options":"{security_barrier=true}","def":" SELECT key,\n    value\n   FROM platform_settings s\n  WHERE key = ANY (ARRAY['features.halls_enabled'::text, 'features.tables_enabled'::text, 'features.orders_enabled'::text, 'access.low_stock_threshold'::text, 'finance.service_fee_rate'::text, 'finance.min_paid_price'::text]);"}
[AUDIT-CATALOGUE] {"view":"public_partners","owner":"postgres","options":"{security_barrier=true}","def":" SELECT id,\n    COALESCE(NULLIF(btrim(commercial_name), ''::text), 'Partenaire Event Village'::text) AS public_name,\n    logo_url,\n    city,\n    description,\n    status\n   FROM partners p\n  WHERE status = 'VALIDE'::partner_status;"}

