                      {newRole === 'ADMIN' && (<span><strong>Gestion :</strong> Accès console administration avec attribution de permissions personnalisées.</span>)}
                      {newRole === 'SUPERADMIN' && (<span><strong>Accès Maître :</strong> Tous les privilèges administratifs et financiers de la plateforme.</span>)}
