	-- public-images/<chemin>), NULL pour toute autre adresse. Aide interne.
	CREATE OR REPLACE FUNCTION public.poster_path_of(p_url text)
	RETURNS text
	LANGUAGE sql
	IMMUTABLE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	    SELECT CASE
	        WHEN p_url IS NULL THEN NULL
