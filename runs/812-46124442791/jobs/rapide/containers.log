	CREATE OR REPLACE FUNCTION private.notif_payment_cart_paid()
	RETURNS trigger
	LANGUAGE plpgsql
	VOLATILE
	SECURITY DEFINER
	SET search_path = public
	AS $$
	DECLARE
	    v_cart text := private.payment_cart_key(NEW.id);
