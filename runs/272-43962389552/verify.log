                              </Button>
                            </td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                )}
              </div>
              )}
        
              {}
              {selectedLog && (
                <Modal
                  isOpen={!!selectedLog}
                  onClose={() => setSelectedLog(null)}
                  title={`Audit Log #${selectedLog.id.slice(0, 8)} • ${selectedLog.action}`}
                >
                  <div className="space-y-4 text-xs">
                    <div className="grid grid-cols-2 gap-2 text-slate-600 dark:text-zinc-400">
