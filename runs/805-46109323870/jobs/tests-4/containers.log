	           AND d.defaclobjtype = 'r'
	           AND a.grantee IN ('anon'::regrole::oid, 'authenticated'::regrole::oid)
	           AND a.privilege_type IN ('INSERT', 'UPDATE', 'DELETE', 'TRUNCATE')
	    ) s;
