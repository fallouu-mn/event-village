        function LazyOfflineTicketsSync() {
            const [Sync, setSync] = useState<OfflineSyncComponent | null>(null);
            useEffect(() => {
                if (Sync)
                    return;
                let active = true;
                const load = () => {
                    loadOfflineTicketsSync()
                        .then((component) => {
                        if (active)
                            setSync(() => component);
                    })
                        .catch((err: unknown) => {
                        console.error('[AuthProvider] synchronisation des billets hors ligne non chargée (nouvel essai au retour du réseau) :', err instanceof Error ? err.message : String(err));
