        export function SalesTab({ eventId, signal }: { eventId: string; signal: number }) {
            const sales = useServerData<PilotageSales>(`/api/partner/events/${eventId}/pilotage/sales`, signal);
        
            return (
                <div className="flex flex-col gap-6">
